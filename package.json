{
  "name": "@dimension-studios/ai-changelog",
  "version": "1.0.7",
  "description": "Semantic-release plugin that generates AI release notes and posts them to Discord.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dimension-studios-inc/ai-changelog.git"
  },
  "bin": {
    "ai-changelog": "dist/cli.mjs"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check": "oxlint && oxfmt --check",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "knip": "knip",
    "release": "semantic-release",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "ai": "7.0.114",
    "execa": "10.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.6.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "semantic-release": "^25.0.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "lefthook"
  ]
}
