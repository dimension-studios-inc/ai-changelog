{
  "name": "@dimension-studios/ai-changelog",
  "version": "1.0.7",
  "description": "Semantic-release plugin that generates AI release notes and posts them to Discord.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dimension-studios-inc/ai-changelog.git"
  },
  "bin": {
    "ai-changelog": "dist/cli.mjs"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "bun check --no-script",
    "test": "vitest run",
    "check": "oxlint && oxfmt --check",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "ai": "7.0.137",
    "execa": "10.1.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.5",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "semantic-release": "^25.0.0"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "lefthook"
  ]
}
