{
  "name": "@dimension-studios/ai-changelog",
  "version": "0.0.0-development",
  "description": "Semantic-release plugin that generates AI release notes and posts them to Discord.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dimension-studios-inc/ai-changelog.git"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "source": "./src/index.ts",
  "bin": {
    "ai-changelog": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "release": "semantic-release",
    "prepare": "lefthook install"
  },
  "peerDependencies": {
    "semantic-release": "^25.0.0"
  },
  "dependencies": {
    "ai": "7.0.84",
    "execa": "9.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.3",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "semantic-release": "25.0.9",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.0.0"
}
